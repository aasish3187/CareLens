# CareLens AI Health Copilot Configuration
APP_NAME=CareLens
ENV=production
DEBUG=False
DEMO_MODE=False

# Google Gemini VLM (Primary Multimodal Vision)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest
LLM_TEMPERATURE=0.0

# Groq Cloud (Ultra-Fast 500+ tok/s LLM Verifier)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# OpenRouter (Reasoning / Fallback)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Document Storage & Processing
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=15

# Database URL (Defaults to SQLite carelens.db)
DATABASE_URL=sqlite:///./carelens.db
PORT=8000
