# CareLens Backend Environment Configuration
APP_NAME=CareLens
ENV=development
DEBUG=True
DEMO_MODE=True

# Google Gemini API Key (Optional for demo mode, provides zero-latency synthetic fallback)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
LLM_TEMPERATURE=0.0

# Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=15

# ABDM & Indic Features
ENABLE_ABDM_FHIR=True
MOCK_ABHA_PREFIX=91
ENABLE_TELUGU=True
ENABLE_HINDI=True
ENABLE_TAMIL=True
